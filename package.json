{
  "name": "cascade-reference-tables",
  "private": true,
  "type": "module",
  "description": "The project's reference tables: the contract, the host, the builders and the feed.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b && node --test \"dist/host/test/**/*.test.js\"",
    "host": "tsc -b && node dist/host/src/cli.js"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "20.1.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "ajv": "8.17.1",
    "oxigraph": "0.5.11",
    "rdf-canonize": "5.0.0",
    "rdf-validate-shacl": "0.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
