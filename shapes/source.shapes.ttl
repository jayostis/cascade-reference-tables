@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tables: <https://ns.cascadeprotocol.org/tables/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tables:SourceShape a sh:NodeShape ;
    sh:targetClass tables:Source ;
    sh:class dcat:Dataset ;
    sh:message "A source is also a dcat:Dataset."@en ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A source has one name."@en
    ] , [
        sh:path dct:publisher ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A source names its one publisher."@en
    ] , [
        sh:path dct:license ;
        sh:in (
            <http://creativecommons.org/publicdomain/mark/1.0/>
            <http://creativecommons.org/publicdomain/zero/1.0/>
            <https://www.ncbi.nlm.nih.gov/home/about/policies/>
            <https://loinc.org/license/>
            <http://creativecommons.org/licenses/by-nd/4.0/>
            <https://www.nlm.nih.gov/research/umls/knowledge_sources/metathesaurus/release/license_agreement.html>
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A source names its one licence, one the tables list."@en
    ] , [
        sh:path ( dct:license [ sh:inversePath tables:licencePolicyOf ] tables:publishesRows ) ;
        sh:hasValue true ;
        sh:message "A source's licence's policy publishes the rows made from it."@en
    ] , [
        sh:path dct:bibliographicCitation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A source states the credit its publisher asks for."@en
    ] , [
        sh:path tables:detectedBy ;
        sh:in ( tables:ConditionalGet tables:ReleaseApi tables:FolderListing tables:DatedUrl tables:Announcement ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A source is detected by one of the host's methods."@en
    ] , [
        sh:path dcat:distribution ;
        sh:minCount 1 ;
        sh:message "A source has at least one file."@en
    ] , [
        sh:path [ sh:inversePath dct:source ] ;
        sh:minCount 1 ;
        sh:node tables:SeriesDeclarationShape ;
        sh:message "A source fills at least one series, each a urn:uuid: with one name and one table kind."@en
    ] .

tables:ArchivedFilesShape a sh:NodeShape ;
    sh:targetClass tables:Source ;
    sh:or (
        [
            sh:property [
                sh:path ( dct:license [ sh:inversePath tables:licencePolicyOf ] tables:archivesPublisherFiles ) ;
                sh:hasValue true
            ]
        ]
        [ sh:property [ sh:path ( dcat:distribution tables:archived ) ; sh:in ( false ) ] ]
    ) ;
    sh:message "A source whose licence's policy archives none of its publisher's files marks none archived."@en .

tables:SourceFilesShape a sh:NodeShape ;
    sh:targetClass tables:Source ;
    sh:or (
        [
            sh:property [ sh:path tables:detectedBy ; sh:hasValue tables:ReleaseApi ] ,
                [
                    sh:path tables:releaseApi ;
                    sh:nodeKind sh:IRI ;
                    sh:pattern "^https://[^/]+/" ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ,
                [ sh:path tables:folderListing ; sh:maxCount 0 ] ,
                [ sh:path dcat:distribution ; sh:node tables:ArchivedFileShape ]
        ]
        [
            sh:property [ sh:path tables:detectedBy ; sh:hasValue tables:FolderListing ] ,
                [
                    sh:path tables:folderListing ;
                    sh:nodeKind sh:IRI ;
                    sh:pattern "^https://[^/]+/.*/$" ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ,
                [ sh:path tables:releaseFolder ; sh:minCount 1 ; sh:node tables:ReleaseFolderShape ] ,
                [ sh:path tables:releaseApi ; sh:maxCount 0 ] ,
                [ sh:path dcat:distribution ; sh:node tables:ListedFileShape ]
        ]
        [
            sh:property [ sh:path tables:detectedBy ; sh:in ( tables:ConditionalGet ) ] ,
                [ sh:path tables:releaseApi ; sh:maxCount 0 ] ,
                [ sh:path tables:folderListing ; sh:maxCount 0 ] ,
                [ sh:path dcat:distribution ; sh:node tables:SourceFileShape ]
        ]
        [
            sh:property [ sh:path tables:detectedBy ; sh:hasValue tables:DatedUrl ] ,
                [ sh:path tables:releaseApi ; sh:maxCount 0 ] ,
                [ sh:path tables:folderListing ; sh:maxCount 0 ] ,
                [ sh:path dcat:distribution ; sh:or ( tables:SourceFileShape tables:DatedFileShape ) ] ,
                [
                    sh:path dcat:distribution ;
                    sh:qualifiedValueShape tables:DatedFileShape ;
                    sh:qualifiedMinCount 1
                ]
        ]
        [
            sh:property [ sh:path tables:detectedBy ; sh:hasValue tables:Announcement ] ,
                [
                    sh:path tables:announcementPage ;
                    sh:nodeKind sh:IRI ;
                    sh:pattern "^https://[^/]+/" ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ,
                [
                    sh:path tables:namePattern ;
                    sh:datatype xsd:string ;
                    sh:pattern "^[^()]*\\((?!\\?)[^()]*\\)[^()]*$" ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ,
                [ sh:path tables:releaseApi ; sh:maxCount 0 ] ,
                [ sh:path tables:folderListing ; sh:maxCount 0 ] ,
                [ sh:path dcat:distribution ; sh:node tables:UnarchivedFileShape ]
        ]
    ) ;
    sh:message "A source detected by its release API names that API and each file by its path in the release's zip; one detected by a folder listing names the listing, at least one kind of release folder, and each file by its name and a pattern for it; one detected by a dated address names at least one file by its name and its address with {month}, and its other files by their download URL; one detected by its announcement names the public page and a name pattern with one group, the version, and each file by its path in the release's folder, none archived; any other source names each file's one download URL."@en .

tables:AnnouncementPageShape a sh:NodeShape ;
    sh:targetSubjectsOf tables:announcementPage ;
    sh:property [
        sh:path tables:detectedBy ;
        sh:hasValue tables:Announcement ;
        sh:message "Only a source detected by its announcement names an announcement page."@en
    ] .

tables:UnarchivedFileShape a sh:NodeShape ;
    sh:node tables:ArchivedFileShape ;
    sh:property [
        sh:path tables:archived ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:message "A file of a source detected by its announcement is never archived: its release is not public."@en
    ] .

tables:DatedFileShape a sh:NodeShape ;
    sh:property [
        sh:path dct:title ;
        sh:datatype xsd:string ;
        sh:pattern "^[^/]+$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path tables:urlTemplate ;
        sh:datatype xsd:string ;
        sh:pattern "^https://[^/]+/.*[{]month[}].*[^/]$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path dcat:downloadURL ;
        sh:maxCount 0
    ] .

tables:FileDeclarationShape a sh:NodeShape ;
    sh:targetObjectsOf dcat:distribution ;
    sh:property [
        sh:path dcat:compressFormat ;
        sh:in ( <https://www.iana.org/assignments/media-types/application/gzip> ) ;
        sh:maxCount 1 ;
        sh:message "A file of a source is compressed, if at all, as gzip."@en
    ] , [
        sh:path tables:archived ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "A file of a source says once, as a boolean, whether the release archives it."@en
    ] .

tables:ReleaseFolderShape a sh:NodeShape ;
    sh:property [
        sh:path tables:namePattern ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path tables:effectiveFrom ;
        sh:nodeKind sh:Literal ;
        sh:pattern "^--(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path tables:yearOffset ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

tables:ListedFileShape a sh:NodeShape ;
    sh:property [
        sh:path dct:title ;
        sh:datatype xsd:string ;
        sh:pattern "^[^/]+$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path tables:namePattern ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path tables:archivePattern ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] , [
        sh:path dcat:downloadURL ;
        sh:maxCount 0
    ] .

tables:ArchivedFileShape a sh:NodeShape ;
    sh:property [
        sh:path dct:title ;
        sh:datatype xsd:string ;
        sh:pattern "^[^/].*[^/]$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path dcat:downloadURL ;
        sh:maxCount 0
    ] .

tables:SourceFileShape a sh:NodeShape ;
    sh:property [
        sh:path dcat:downloadURL ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://[^/]+/.*[^/]$" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

tables:SeriesDeclarationShape a sh:NodeShape ;
    sh:class rec:ReferenceSeries ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path rec:tableKind ;
        sh:class rec:TableKind ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path rec:coversGene ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A series declares the genes it covers by their symbols, each a non-empty plain string."@en
    ] .

tables:CarryingSeriesShape a sh:NodeShape ;
    sh:targetSubjectsOf tables:carriesForward ;
    sh:property [
        sh:path tables:carriesForward ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "A series says once, as a boolean, whether it carries rows forward."@en
    ] , [
        sh:path rec:tableKind ;
        sh:not [ sh:hasValue rec:CodeStatus ] ;
        sh:message "A series carrying rows forward does not hold code status."@en
    ] .

tables:HistoryLookupCountShape a sh:NodeShape ;
    sh:targetClass tables:Source ;
    sh:property [
        sh:path tables:historyLookup ;
        sh:maxCount 1 ;
        sh:message "A source has at most one history lookup."@en
    ] .

tables:HistoryLookupShape a sh:NodeShape ;
    sh:targetObjectsOf tables:historyLookup ;
    sh:property [
        sh:path tables:codeSystem ;
        sh:class rec:CodeSystem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A history lookup names one code system and one URL template, which holds {code}."@en
    ] , [
        sh:path tables:urlTemplate ;
        sh:datatype xsd:string ;
        sh:pattern "[{]code[}]" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A history lookup names one code system and one URL template, which holds {code}."@en
    ] .

tables:HistoryLookupSeriesShape a sh:NodeShape ;
    sh:targetSubjectsOf tables:historyLookup ;
    sh:property [
        sh:path [ sh:inversePath dct:source ] ;
        sh:qualifiedValueShape [
            sh:property [ sh:path rec:tableKind ; sh:hasValue rec:CodeStatus ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A source with a history lookup fills exactly one code status series."@en
    ] , [
        sh:path [ sh:inversePath dct:source ] ;
        sh:qualifiedValueShape [
            sh:property [ sh:path tables:carriesForward ; sh:hasValue true ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A source with a history lookup fills at least one series carrying rows forward."@en
    ] .
