{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.cascadeprotocol.org/tables/v1-draft/builder/interface.schema.json",
  "title": "A row a builder yields",
  "oneOf": [
    { "$ref": "#/$defs/mapping" },
    { "$ref": "#/$defs/member" },
    { "$ref": "#/$defs/names" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/termType" },
    { "$ref": "#/$defs/classification" }
  ],
  "$defs": {
    "iri": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]+$"
    },
    "text": { "type": "string", "minLength": 1 },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series",
        "subject_id",
        "predicate_id",
        "object_id",
        "mapping_justification"
      ],
      "properties": {
        "series": { "$ref": "#/$defs/iri" },
        "subject_id": { "$ref": "#/$defs/iri" },
        "predicate_id": { "$ref": "#/$defs/iri" },
        "object_id": { "$ref": "#/$defs/iri" },
        "mapping_justification": { "$ref": "#/$defs/iri" },
        "mapping_cardinality": { "enum": ["1:1", "1:n", "n:1", "n:n"] }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series",
        "subject_id",
        "predicate_id",
        "object_id",
        "mapping_justification",
        "sequence"
      ],
      "properties": {
        "series": { "$ref": "#/$defs/iri" },
        "subject_id": { "$ref": "#/$defs/iri" },
        "predicate_id": { "$ref": "#/$defs/iri" },
        "object_id": { "$ref": "#/$defs/iri" },
        "mapping_justification": { "$ref": "#/$defs/iri" },
        "sequence": { "type": "integer" },
        "required": { "$ref": "#/$defs/text" }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "subject", "prefLabel", "notation"],
      "properties": {
        "series": { "$ref": "#/$defs/iri" },
        "subject": { "$ref": "#/$defs/iri" },
        "prefLabel": { "$ref": "#/$defs/text" },
        "altLabel": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "notation": { "$ref": "#/$defs/text" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "subject"],
      "properties": {
        "series": { "$ref": "#/$defs/iri" },
        "subject": { "$ref": "#/$defs/iri" },
        "replacedBy": { "type": "array", "items": { "$ref": "#/$defs/iri" } }
      }
    },
    "iris": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/iri" }
    },
    "count": { "type": "integer", "minimum": 0 },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "variation"],
      "minProperties": 3,
      "not": { "required": ["contributingSubmitterCount", "submitterCount"] },
      "properties": {
        "series": { "$ref": "#/$defs/iri" },
        "variation": { "$ref": "#/$defs/iri" },
        "hgvs": { "$ref": "#/$defs/iris" },
        "classification": { "$ref": "#/$defs/iris" },
        "reviewStatus": { "$ref": "#/$defs/iri" },
        "lastEvaluated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "contributingSubmitterCount": { "$ref": "#/$defs/count" },
        "submitterCount": { "$ref": "#/$defs/count" }
      }
    },
    "termType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "subject", "termType"],
      "properties": {
        "series": { "$ref": "#/$defs/iri" },
        "subject": { "$ref": "#/$defs/iri" },
        "termType": { "$ref": "#/$defs/text" }
      }
    }
  }
}
