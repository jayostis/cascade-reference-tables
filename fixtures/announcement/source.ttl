<urn:uuid:3b1e5c64-8d2a-4f7b-9a10-6c2d4e8f1b35> a tables:Source, dcat:Dataset ;
    rdfs:label "Example vaccine codes, by announcement" ;
    dct:publisher <https://publisher.example/> ;
