@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix tables: <https://ns.cascadeprotocol.org/tables/v1-draft#> .

<urn:uuid:7b3f1c84-2d65-4e09-a1f7-6c9d0e8b4a23> a tables:Source, dcat:Dataset ;
    rdfs:label "Example vaccine codes, carried forward" ;
    dct:publisher <https://publisher.example/> ;
    dct:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:bibliographicCitation "Source: an example publisher" ;
    tables:detectedBy tables:ConditionalGet ;
    tables:historyLookup [
        tables:codeSystem cascade:CVX ;
        tables:urlTemplate "https://publisher.example/history/{code}"
    ] ;
    dcat:distribution [ dcat:downloadURL <https://publisher.example/downloads/codes.txt> ] .

<urn:uuid:c1a6678c-2b4d-4287-b852-9039e6a71afd> a cascade:ReferenceSeries ;
    rdfs:label "Example vaccine groups" ;
    cascade:tableKind cascade:VaccineGroups ;
    tables:carriesForward true ;
    dct:source <urn:uuid:7b3f1c84-2d65-4e09-a1f7-6c9d0e8b4a23> .

<urn:uuid:6e9c1dc9-8c36-49a8-929c-cd9f6701076c> a cascade:ReferenceSeries ;
    rdfs:label "Example vaccine names" ;
    cascade:tableKind cascade:CodeNames ;
    tables:carriesForward true ;
